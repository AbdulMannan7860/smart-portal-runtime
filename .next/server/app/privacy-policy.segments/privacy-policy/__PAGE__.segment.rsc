h-1.5 w-1.5 shrink-0 rounded-full bg-[#6D0303]"}],["$","span",null,{"children":"Selecting Remember me creates a longer-lived authenticated session on that device. On shared devices, leave it unchecked and always sign out when finished."}]]}],["$","li","Users are responsible for protecting their passwords, devices, verification links, and active sessions. Suspected account misuse should be reported immediately through IT Support.",{"className":"flex gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-[#6D0303]"}],["$","span",null,{"children":"Users are responsible for protecting their passwords, devices, verification links, and active sessions. Suspected account misuse should be reported immediately through IT Support."}]]}]]}]]}]
