2:T7e8,{"@context":"https://schema.org","@graph":[{"@type":"WebPage","@id":"https://lms.emaan.edu.pk/privacy-policy#webpage","url":"https://lms.emaan.edu.pk/privacy-policy","name":"EIMS LMS Privacy, Attendance & Academic Policies","description":"Read EIMS LMS privacy, attendance, automatic absence, student leave, teacher leave, academic holiday, off-day, class cancellation, make-up class, examination, result and portal-use policies.","dateModified":"2026-08-17","inLanguage":"en","about":["LMS privacy policy","Student attendance policy","Student and teacher leave policy","Academic holiday and off-day policy","Class cancellation and make-up class policy"]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"When does EIMS LMS automatically mark a student absent?","acceptedAnswer":{"@type":"Answer","text":"For an eligible active scheduled class, unmarked Active students may be marked Absent after the configured attendance window closes. The current standard window is six hours from class start, and the background process rechecks a rolling seven-day period."}},{"@type":"Question","name":"Does EIMS LMS mark attendance on a holiday or academic off-day?","acceptedAnswer":{"@type":"Answer","text":"No. An active Holiday or Off Day that applies to the Institute, program, or session suppresses attendance and automatic absence for the affected class."}},{"@type":"Question","name":"Does submitting student leave immediately change attendance?","acceptedAnswer":{"@type":"Answer","text":"No. Student-submitted leave stays Requested until Management or Admin approves it. After approval, matching absence records can be changed to Leave for the approved date range."}},{"@type":"Question","name":"Does teacher leave automatically cancel every class?","acceptedAnswer":{"@type":"Answer","text":"No. The affected schedules must be formally cancelled, reassigned, marked off, or supported through approved make-up classes. This is especially important for merged classes covering multiple programs or batches."}}]}]}0:{"rsc":["$","$1","c",{"children":[["$","main",null,{"className":"min-h-screen bg-slate-50 text-slate-900","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$2"}}],["$","header",null,{"className":"border-b border-red-950/15 bg-gradient-to-br from-[#6D0303] via-[#850707] to-[#3e0101] text-white","children":["$","div",null,{"className":"mx-auto max-w-6xl px-5 py-8 sm:px-8 sm:py-12","children":["$","div",null,{"className":"flex flex-col gap-7 md:flex-row md:items-center md:justify-between","children":[["$","div",null,{"className":"flex items-center gap-4","children":[["$","div",null,{"className":"flex h-16 w-16 shrink-0 items-center justify-center rounded-2xl bg-white p-2 shadow-lg sm:h-20 sm:w-20","children":["$","$L3",null,{"src":"/logo.svg","alt":"Emaan Institute logo","width":72,"height":72,"priority":true}]}],["$","div",null,{"children":[["$","p",null,{"className":"text-sm font-semibold uppercase tracking-[0.2em] text-red-100","children":"EIMS LMS"}],["$","h1",null,{"className":"mt-1 text-3xl font-bold tracking-tight sm:text-4xl","children":"Privacy & Portal Policies"}],["$","p",null,{"className":"mt-2 max-w-2xl text-sm leading-6 text-red-50 sm:text-base","children":"Official guidance for institutional data, student attendance, leave, holidays, class operations, academic records, and responsible Learning Management System use."}]]}]]}],["$","$L4",null,{"href":"/login","className":"inline-flex w-fit items-center gap-2 rounded-xl border border-white/30 bg-white/10 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-white hover:text-[#6D0303]","children":["$L5","Back to login"]}]]}]}]}],"$L6"]}],["$L7"],"$L8"]}],"isPartial":false,"staleTime":300,"varyParams":null,"buildId":"RZTeZJQpzrpCRynKLEM45"}
